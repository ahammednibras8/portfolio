{
  "name": "ahammednibras8-portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "A proof-first engineering portfolio built as a static Astro site.",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run lint:eslint && pnpm run lint:styles && pnpm run lint:spelling",
    "lint:eslint": "eslint .",
    "lint:html": "html-validate --config htmlvalidate.config.mjs \"dist/**/*.html\"",
    "lint:spelling": "cspell --no-progress --no-summary",
    "lint:styles": "stylelint \"**/*.{astro,css}\" --allow-empty-input",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run check",
    "test:accessibility": "playwright test tests/accessibility",
    "test:browser": "playwright test",
    "test:browser:chromium": "playwright test --project=chromium",
    "test:browser:cross": "playwright test --project=firefox --project=webkit",
    "test:e2e": "playwright test tests/e2e",
    "test:performance": "pnpm run build && lhci autorun"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.5.1"
  },
  "packageManager": "pnpm@12.5.1",
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "astro": "7.3.3",
    "cspell": "10.3.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "html-validate": "11.16.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "stylelint": "17.15.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
