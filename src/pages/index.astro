---
import DocumentLayout from "../layouts/DocumentLayout.astro";
import EmailContact from "../components/EmailContact.astro";
import GitHubIcon from "../assets/github.svg";
import LinkedInIcon from "../assets/linkedin-in.svg";
import { profile } from "../data/profile";
import { experience } from "../data/experience";

const title = `${profile.name} — ${profile.role}`;
const description = profile.description;
const canonical = new URL("/", Astro.site ?? Astro.url);
---

<DocumentLayout title={title} description={description} canonical={canonical}>
  <section
    class="introduction signature-band"
    aria-labelledby="introduction-heading"
  >
    <h1 id="introduction-heading">
      Hi, I’m <span itemprop="name">{profile.name}</span>.
    </h1>

    <p>
      <span itemprop="jobTitle">{profile.role}</span> ·{" "}
      <span
        itemprop="homeLocation"
        itemscope
        itemtype="https://schema.org/Place"
      >
        <span itemprop="name">{profile.location}</span>
      </span>
    </p>

    <p>I build AI products and the backend systems they depend on.</p>

    <ul class="profile-links">
      <li>
        <a
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
          aria-describedby="new-tab-hint"
          itemprop="sameAs"
          href={profile.github}
        >
          <GitHubIcon
            width="16"
            height="16"
            aria-hidden="true"
            focusable="false"
          />
          GitHub
        </a>
      </li>
      <li>
        <a
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
          aria-describedby="new-tab-hint"
          itemprop="sameAs"
          href={profile.linkedin}
        >
          <LinkedInIcon
            width="16"
            height="16"
            aria-hidden="true"
            focusable="false"
          />
          LinkedIn
        </a>
      </li>
    </ul>
  </section>

  <section id="experience" aria-labelledby="experience-heading">
    <h2 id="experience-heading">Experience</h2>

    <ol class="experience-list">
      {experience.map((entry) => (
        <li>
          <h3>
            {entry.role} ·{" "}
            <a
              target="_blank"
              rel="noopener noreferrer"
              title="Opens in a new tab"
              aria-describedby="new-tab-hint"
              href={entry.organizationUrl}
            >
              {entry.organization}
            </a>
          </h3>
          <p class="experience-dates">
            <time datetime={entry.start}>{entry.startLabel}</time> —{" "}
            {entry.end ? (
              <time datetime={entry.end}>{entry.endLabel}</time>
            ) : (
              entry.endLabel
            )}
          </p>
          <p class="experience-context">{entry.context}</p>
        </li>
      ))}
    </ol>
  </section>

  <section
    id="contact"
    class="signature-band"
    aria-labelledby="contact-heading"
  >
    <h2 id="contact-heading">Contact</h2>

    <p>If you want to discuss a role or project, email me.</p>

    <EmailContact email={profile.email} />
  </section>
</DocumentLayout>
