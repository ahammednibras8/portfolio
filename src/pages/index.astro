---
import DocumentLayout from "../layouts/DocumentLayout.astro";

const title = "Ahammed Nibras — Software engineer";
const description =
  "Ahammed Nibras is a software engineer who builds AI products and the systems that keep them running.";
const canonical = new URL("/", Astro.site ?? Astro.url);
const socialImage = {
  url: new URL("/social/home.png", Astro.site ?? Astro.url),
  alt: "The portfolio homepage with the heading “Hi, I’m Nibras.” and the selected Cascade project.",
  type: "image/png",
  width: 1200,
  height: 630,
} as const;
---

<DocumentLayout
  title={title}
  description={description}
  canonical={canonical}
  socialImage={socialImage}
>
  <section class="introduction" aria-labelledby="introduction-heading">
    <h1 id="introduction-heading">Hi, I’m Nibras.</h1>

    <p>I build AI products and the backend systems they depend on.</p>

    <p>
      My work often starts with an action on a screen. I follow it through the
      API, database, queue, and worker, then back to the result or failure the
      user sees.
    </p>
  </section>

  <section id="routes" class="homepage-routes" aria-labelledby="routes-heading">
    <header class="routes-introduction">
      <span class="route-label">System index</span>
      <h2 id="routes-heading">Follow the work</h2>
      <p>
        Move from the project, through the system behind this site, to a direct
        way to get in touch.
      </p>
    </header>

    <nav aria-label="Portfolio routes">
      <ul class="route-list">
        <li>
          <a class="route-link route-link-lead" href="/work/cascade/">
            <h3>Cascade</h3>
            <div class="route-placard">
              <span class="route-label">
                <span aria-hidden="true">01 ·&nbsp;</span>
                Project
              </span>
              <p>
                A background-task system designed around durable records,
                retries, isolation, and recovery.
              </p>
              <span class="route-action">Read the case study</span>
            </div>
          </a>
        </li>

        <li>
          <a class="route-link" href="/architecture/">
            <h3>How this site runs</h3>
            <div class="route-placard">
              <span class="route-label">
                <span aria-hidden="true">02 ·&nbsp;</span>
                Infrastructure
              </span>
              <p>
                The static build, verification pipeline, preview gate, and
                Cloudflare deployment behind this portfolio.
              </p>
              <span class="route-action">Inspect the architecture</span>
            </div>
          </a>
        </li>

        <li>
          <a class="route-link" href="/contact/">
            <h3>Start a conversation</h3>
            <div class="route-placard">
              <span class="route-label">
                <span aria-hidden="true">03 ·&nbsp;</span>
                Contact
              </span>
              <p>
                Email, GitHub, and LinkedIn for roles, projects, or
                collaboration.
              </p>
              <span class="route-action">Choose a contact path</span>
            </div>
          </a>
        </li>
      </ul>
    </nav>
  </section>
</DocumentLayout>
