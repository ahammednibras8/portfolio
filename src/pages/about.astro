---
import { profile } from "../data/profile";
import DocumentLayout from "../layouts/DocumentLayout.astro";
import EmailContact from "../components/EmailContact.astro";
import Experience from "../components/Experience.astro";
import GitHubIcon from "../assets/github.svg";
import LinkedInIcon from "../assets/linkedin-in.svg";

const title = `About ${profile.name} — ${profile.role}`;
const canonical = new URL("/about/", Astro.site ?? Astro.url);
---

<DocumentLayout
  title={title}
  description={profile.description}
  canonical={canonical}
  pageType="ProfilePage"
>
  <section class="introduction signature-band" aria-labelledby="about-heading">
    <h1 id="about-heading">
      About <span itemprop="name">{profile.name}</span>
    </h1>

    <p>
      <span itemprop="jobTitle">{profile.role}</span> ·{" "}
      <span
        itemprop="homeLocation"
        itemscope
        itemtype="https://schema.org/Place"
      >
        <span itemprop="name">{profile.location}</span>
      </span>
    </p>

    <p>
      I build AI products and the backend systems they depend on.{" "}
      <a
        target="_blank"
        rel="noopener noreferrer"
        title="Opens in a new tab"
        aria-describedby="new-tab-hint"
        href="/"
      >
        Back to home
      </a>
      .
    </p>
    <ul class="profile-links">
      <li>
        <a
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
          aria-describedby="new-tab-hint"
          itemprop="sameAs"
          href={profile.github}
        >
          <GitHubIcon
            width="16"
            height="16"
            aria-hidden="true"
            focusable="false"
          />
          GitHub
        </a>
      </li>
      <li>
        <a
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
          aria-describedby="new-tab-hint"
          itemprop="sameAs"
          href={profile.linkedin}
        >
          <LinkedInIcon
            width="16"
            height="16"
            aria-hidden="true"
            focusable="false"
          />
          LinkedIn
        </a>
      </li>
    </ul>
  </section>

  <section id="experience" aria-labelledby="experience-heading">
    <h2 id="experience-heading">Experience</h2>

    <Experience />
  </section>

  <section aria-labelledby="approach-heading">
    <h2 id="approach-heading">How I work</h2>

    <p>
      My work often starts with an action on a screen. I follow it through the
      API, database, queue, and worker, then back to the result or failure the
      user sees.
    </p>
  </section>

  <section aria-labelledby="contact-heading">
    <h2 id="contact-heading">Contact</h2>

    <EmailContact email={profile.email} />
  </section>
</DocumentLayout>
