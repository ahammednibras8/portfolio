---
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-700.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "../styles/global.css";
import { profile } from "../data/profile";

interface Props {
  title: string;
  description: string;
  canonical?: URL;
  trackPage?: boolean;
}

const { title, description, canonical, trackPage = false } = Astro.props;

const canonicalUrl = canonical?.href;
const isHomepage = Astro.url.pathname === "/";
const homepage = new URL("/", Astro.site ?? Astro.url);
const websiteId = new URL("#website", homepage).href;
const personId = new URL("#person", homepage).href;
---

<!doctype html>
<html lang="en">
  <head
    itemscope={isHomepage}
    itemtype={isHomepage ? "https://schema.org/WebSite" : undefined}
    itemid={isHomepage ? websiteId : undefined}
  >
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#f3f1ed" />
    <meta name="viewport" content="width=device-width" />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {isHomepage && (
      <>
        <meta itemprop="name" content={profile.name} />
        <link itemprop="url" href={homepage.href} />
      </>
    )}

    <link
      rel="icon"
      href="/favicon.ico"
      sizes="16x16 32x32 64x64"
      type="image/x-icon"
    />
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />

    <meta property="og:site_name" content={profile.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>

    <script>
      import approved from "../data/analytics-campaigns.json";

      function shouldLoadAnalytics() {
        if (
          import.meta.env.PUBLIC_ANALYTICS_ENABLED !== "true" ||
          window.location.origin !== "https://ahammednibras.com" ||
          document.body?.dataset.analyticsPath !== window.location.pathname
        ) {
          return false;
        }

        try {
          return window.localStorage.getItem("umami.disabled") === null;
        } catch {
          return false;
        }
      }

      if (shouldLoadAnalytics()) {
        const analyticsWebsiteId = "994f1189-2ae4-48b0-9b15-6b8c6f5c785f";
        const allowedEvents = new Set([
          "contact_gmail_clicked",
          "contact_email_app_clicked",
          "contact_email_copied",
        ]);

        const analytics = Object.assign(window, {
          portfolioAnalyticsBeforeSend(type: string, input: unknown) {
            if (
              type !== "event" ||
              !shouldLoadAnalytics() ||
              typeof input !== "object" ||
              input === null ||
              Array.isArray(input)
            ) {
              return false;
            }

            const payload = input as Record<string, unknown>;
            if (payload.website !== analyticsWebsiteId) return false;

            const name = payload.name;
            let eventData: Record<string, string> | null = null;

            if (name === "outbound_clicked") {
              const data = payload.data;
              if (
                typeof data !== "object" ||
                data === null ||
                !("destination" in data)
              ) {
                return false;
              }

              const { destination } = data;
              const isProfile =
                destination === "github_profile" ||
                destination === "linkedin_profile";
              const isEmployer =
                destination === "Insource Data" || destination === "NysaClan";

              if (!isProfile && !isEmployer) return false;

              eventData = {
                destination,
                placement: isProfile ? "introduction" : "experience",
              };
            } else if (name === "section_view") {
              const data = payload.data;
              if (
                typeof data !== "object" ||
                data === null ||
                !("section" in data)
              ) {
                return false;
              }

              const { section } = data;
              if (section !== "experience" && section !== "contact")
                return false;

              eventData = { section };
            } else if (
              typeof name !== "undefined" &&
              (typeof name !== "string" || !allowedEvents.has(name))
            ) {
              return false;
            }

            let referrer = "";
            if (typeof payload.referrer === "string" && payload.referrer) {
              try {
                const source = new URL(payload.referrer);
                if (
                  source.protocol === "https:" &&
                  source.origin !== window.location.origin
                ) {
                  referrer = source.origin;
                }
              } catch {
                // Discard malformed and relative referrers.
              }
            }

            const incoming = new URLSearchParams(window.location.search);
            const campaign = new URLSearchParams();

            for (const [key, allowedValues] of Object.entries(approved)) {
              const [value, duplicate] = incoming.getAll(key);
              if (
                value &&
                duplicate === undefined &&
                allowedValues.includes(value)
              ) {
                campaign.set(key, value);
              }
            }

            const path = window.location.pathname;
            const url = campaign.size ? `${path}?${campaign}` : path;

            return {
              website: analyticsWebsiteId,
              hostname: "ahammednibras.com",
              url,
              title: document.title,
              language: navigator.language,
              screen: `${window.screen.width}x${window.screen.height}`,
              referrer,
              ...(typeof name === "string" ? { name } : {}),
              ...(eventData ? { data: eventData } : {}),
            };
          },
        });

        const tracker = document.createElement("script");
        tracker.src = "https://cloud.umami.is/script.js";
        tracker.async = true;
        tracker.referrerPolicy = "no-referrer";
        tracker.dataset.websiteId = analyticsWebsiteId;
        tracker.dataset.hostUrl = "https://gateway.umami.is";
        tracker.dataset.autoTrack = "false";
        tracker.dataset.domains = "ahammednibras.com";
        tracker.dataset.excludeSearch = "true";
        tracker.dataset.excludeHash = "true";
        tracker.dataset.beforeSend = "portfolioAnalyticsBeforeSend";

        function sendAnalytics(name?: string, data?: Record<string, string>) {
          try {
            const payload = analytics.portfolioAnalyticsBeforeSend("event", {
              website: analyticsWebsiteId,
              url: "/",
              referrer: document.referrer,
              name,
              data,
            });
            if (!payload) return;

            const umami = (
              window as Window & {
                umami?: {
                  track: (payload: Record<string, unknown>) => unknown;
                };
              }
            ).umami;
            if (typeof umami?.track !== "function") return;

            void Promise.resolve(umami.track(payload)).catch(() => {
              // Tracking failure must not affect the page
            });
          } catch {
            // An unavailable analytics SDK must not affect the page.
          }
        }

        tracker.addEventListener(
          "load",
          () => {
            sendAnalytics();

            if (
              window.location.pathname !== "/" ||
              typeof IntersectionObserver !== "function"
            ) {
              return;
            }

            for (const section of ["experience", "contact"] as const) {
              const heading = document.getElementById(`${section}-heading`);
              if (!heading) continue;

              let timer: number | undefined;
              const observer = new IntersectionObserver(
                (entries) => {
                  window.clearTimeout(timer);
                  if (
                    document.hidden ||
                    entries.at(-1)?.intersectionRatio !== 1
                  ) {
                    return;
                  }

                  timer = window.setTimeout(() => {
                    if (document.hidden) return;
                    sendAnalytics("section_view", { section });
                    observer.disconnect();
                    document.removeEventListener("visibilitychange", reset);
                  }, 1000);
                },
                { threshold: 1 },
              );

              const reset = () => {
                window.clearTimeout(timer);
                observer.disconnect();
                if (!document.hidden) observer.observe(heading);
              };

              document.addEventListener("visibilitychange", reset);
              reset();
            }
          },
          { once: true },
        );

        document.addEventListener("portfolio-contact", (event) => {
          if (
            event instanceof CustomEvent &&
            typeof event.detail === "string" &&
            allowedEvents.has(event.detail)
          ) {
            sendAnalytics(event.detail);
          }
        });

        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) return;

          const link = event.target.closest<HTMLAnchorElement>(
            "a[data-analytics-outbound]",
          );
          const destination = link?.dataset.analyticsOutbound;

          if (destination) {
            sendAnalytics("outbound_clicked", { destination });
          }
        });

        document.head.append(tracker);
      }
    </script>
  </head>

  <body data-analytics-path={trackPage ? Astro.url.pathname : undefined}>
    <main
      id="main-content"
      class="page"
      itemscope={isHomepage}
      itemtype={isHomepage ? "https://schema.org/Person" : undefined}
      itemid={isHomepage ? personId : undefined}
    >
      {isHomepage && <link itemprop="url" href={homepage.href} />}
      <span id="new-tab-hint" hidden>
        Opens in a new tab.
      </span>
      <slot />
    </main>

    <footer class="site-footer">
      <p class="site-footer-location">
        {profile.name} · {profile.location}
      </p>
      <a class="site-footer-link" href={isHomepage ? "/privacy/" : "/"}>
        {isHomepage ? "Privacy" : "Home"}
      </a>
    </footer>
  </body>
</html>
