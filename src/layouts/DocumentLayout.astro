---
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-700.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "../styles/global.css";
import { navigation } from "../data/navigation";
import { profile } from "../data/profile";

interface SocialImage {
  url: URL;
  alt: string;
  type: "image/png" | "image/jpeg" | "image/webp";
  width: number;
  height: number;
}

interface Props {
  title: string;
  description: string;
  canonical?: URL;
  socialImage?: SocialImage;
  pageType?: "ProfilePage";
}

const { title, description, canonical, socialImage, pageType } = Astro.props;

const canonicalUrl = canonical?.href;
const socialImageUrl = socialImage?.url.href;
const isHomepage = Astro.url.pathname === "/";
const homepage = new URL("/", Astro.site ?? Astro.url);
const websiteId = new URL("#website", homepage).href;
const personId = new URL("#person", homepage).href;
const pageId = canonical && new URL("#webpage", canonical).href;
const isPersonPage = isHomepage || pageType === "ProfilePage";
---

<!doctype html>
<html lang="en">
  <head
    itemscope={isHomepage}
    itemtype={isHomepage ? "https://schema.org/WebSite" : undefined}
    itemid={isHomepage ? websiteId : undefined}
  >
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#f3f1ed" />
    <meta name="viewport" content="width=device-width" />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {isHomepage && (
      <>
        <meta itemprop="name" content={profile.name} />
        <link itemprop="url" href={homepage.href} />
      </>
    )}

    <link
      rel="icon"
      href="/favicon.ico"
      sizes="16x16 32x32 64x64"
      type="image/x-icon"
    />
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />

    <meta property="og:site_name" content={profile.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    {socialImage && (
      <>
        <meta property="og:image" content={socialImageUrl} />
        <meta property="og:image:type" content={socialImage.type} />
        <meta property="og:image:width" content={String(socialImage.width)} />
        <meta property="og:image:height" content={String(socialImage.height)} />
        <meta property="og:image:alt" content={socialImage.alt} />
      </>
    )}

    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {socialImage && <meta name="twitter:image:alt" content={socialImage.alt} />}

    <title>{title}</title>
  </head>

  <body
    itemscope={Boolean(pageType)}
    itemtype={pageType && `https://schema.org/${pageType}`}
    itemid={pageType ? pageId : undefined}
  >
    {pageType && canonicalUrl && <link itemprop="url" href={canonicalUrl} />}
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>

    <header class="site-header">
      <nav class="primary-navigation" aria-label="Primary">
        <ul>
          {navigation.map(({ label, href }) => (
            <li>
              <a
                href={
                  isHomepage && href.startsWith("/#") ? href.slice(1) : href
                }
                aria-current={canonical?.pathname === href ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main
      id="main-content"
      class="page"
      tabindex="-1"
      itemscope={isPersonPage}
      itemtype={isPersonPage ? "https://schema.org/Person" : undefined}
      itemid={isPersonPage ? personId : undefined}
      itemprop={pageType ? "mainEntity" : undefined}
    >
      {isPersonPage && <link itemprop="url" href={homepage.href} />}
      <slot />
    </main>

    <footer class="site-footer">
      <p class="site-footer-location">
        {profile.name} · {profile.location}
      </p>
      <a href="#main-content">Back to top</a>
    </footer>
  </body>
</html>
